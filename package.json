{
  "name": "tide-after-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify:assets": "node scripts/verify-production-assets.mjs",
    "test": "vitest run",
    "lint": "eslint client/src/App.tsx client/src/main.tsx client/src/tide client/src/components/tide",
    "lint:upstream": "eslint .",
    "spacetime:build": "spacetime build --module-path server",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir client/src/tide/generated --module-path server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clockworklabs/spacetimedb-sdk": "^1.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@openauthjs/openauth": "^0.4.3",
    "@supabase/supabase-js": "^2.49.4",
    "jose": "^6.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "spacetimedb": "^2.8.1",
    "use-debounce": "^10.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
